@using alfa_test_proj.UI.Pages

@* Последний рубеж: если в разметке что-то упадёт, пользователь увидит сообщение, а не белый экран. *@
<ErrorBoundary @ref="_errorBoundary">
    <ChildContent>
        <MainPage />
    </ChildContent>
    <ErrorContent Context="exception">
        <div class="fatal">
            <h1>Что-то пошло не так</h1>
            <p>Интерфейс столкнулся с непредвиденной ошибкой: @exception.Message</p>
            <p>Подробности записаны в лог в папке <code>logs</code> рядом с приложением.</p>
            <button class="btn btn-dark" @onclick="() => _errorBoundary?.Recover()">Вернуться к работе</button>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    private ErrorBoundary? _errorBoundary;
}
